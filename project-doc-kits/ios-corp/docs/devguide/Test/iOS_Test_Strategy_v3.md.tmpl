## 테스트 클래스 구조

### 메인 테스트 클래스

```swift
import XCTest
import RxCocoa
import RxSwift
@testable import app

/// [Feature]ViewModel 스펙 시나리오를 검증하는 테스트 스위트
final class [Feature]ViewModelTests: XCTestCase {

    // MARK: - Properties

    var actions: Mock[Feature]ViewActions!
    var someUseCase: MockSomeUseCase!
    var sut: Default[Feature]ViewModel!
    var input: Default[Feature]ViewModel.Input!
    var disposeBag: DisposeBag!



    // MARK: - Lifecycle

    override func setUp() {
        super.setUp()
        self.actions = Mock[Feature]ViewActions()
        self.someUseCase = MockSomeUseCase()
        self.sut = Default[Feature]ViewModel(actions: self.actions.actions, ...)
        self.input = Default[Feature]ViewModel.Input()
        self.disposeBag = DisposeBag()
        _ = self.sut.transform(input: self.input, disposeBag: self.disposeBag)
    }

    override func tearDown() {
        self.disposeBag = nil
        self.input = nil
        self.sut = nil
        self.someUseCase = nil
        self.actions = nil
        super.tearDown()
    }
}
```

### Extension 파일 구조

```swift
import XCTest
@testable import app

// MARK: - [카테고리 설명]
// Spec 문서: 10.X. [섹션명]

extension [Feature]ViewModelTests {

    // MARK: - Spec 10.X.1

    /// **Spec 10.X.1**: [테스트 제목]?
    func test[Category]_[condition]_[expected]() { ... }
}
```

