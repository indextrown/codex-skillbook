## ViewModel 템플릿

**파일 위치**: `Presentation/Scene/[Scene]/[Feature]/ViewModel/`

### 추가 섹션

| 섹션 | 용도 |
|------|------|
| **Input / Output** | Input/Output struct 정의 |
| **Transform** | transform 메서드 |

```swift
import Foundation

import RxCocoa
import RxSwift

struct <#ViewName#>ViewModelActions {
    let pushNextViewController: () -> Void
    let dismissViewController: () -> Void
}

protocol <#ViewName#>ViewModelInput {
    var viewDidAppear: PublishRelay<Void> { get }
    var buttonTap: PublishRelay<Void> { get }
    var itemSelected: PublishRelay<Item> { get }
}

protocol <#ViewName#>ViewModelOutput {
    var items: BehaviorRelay<[Item]> { get }
    var presentAlert: PublishRelay<Alert> { get }
}

protocol <#ViewName#>ViewModel {
    func transform(input: <#ViewName#>ViewModelInput, disposeBag: DisposeBag) -> <#ViewName#>ViewModelOutput
}

final class Default<#ViewName#>ViewModel: BaseViewModel, <#ViewName#>ViewModel {

    // MARK: - Input / Output

    struct Input: <#ViewName#>ViewModelInput {
        let viewDidAppear = PublishRelay<Void>()
        let buttonTap = PublishRelay<Void>()
        let itemSelected = PublishRelay<Item>()
    }

    struct Output: <#ViewName#>ViewModelOutput {
        let items = BehaviorRelay<[Item]>(value: [])
        let presentAlert = PublishRelay<Alert>()
    }



    // MARK: - Property

    private let actions: <#ViewName#>ViewModelActions
    private let xxxUseCase: XxxUseCase



    // MARK: - Life Cycle

    init(
        actions: <#ViewName#>ViewModelActions,
        xxxUseCase: XxxUseCase
    ) {
        self.actions = actions
        self.xxxUseCase = xxxUseCase
    }



    // MARK: - Transform

    func transform(input: <#ViewName#>ViewModelInput, disposeBag: DisposeBag) -> <#ViewName#>ViewModelOutput {
        let output = Default<#ViewName#>ViewModel.Output()

        // UseCase Observable 구독
        self.xxxUseCase.observeItems()
            .observe(on: MainScheduler.instance)
            .bind(to: output.items)
            .disposed(by: disposeBag)

        // viewDidAppear: 초기 데이터 로드
        input.viewDidAppear
            .flatMapLatest { [weak self] _ -> Observable<[Item]> in
                guard let self else { return .empty() }
                return self.xxxUseCase.fetchItems()
            }
            .observe(on: MainScheduler.instance)
            .bind(to: output.items)
            .disposed(by: disposeBag)

        // buttonTap: 단순 액션 처리
        input.buttonTap
            .bind { [weak self] in
                self?.actions.pushNextViewController()
            }
            .disposed(by: disposeBag)

        // itemSelected: 복잡한 분기 처리
        input.itemSelected
            .flatMapLatest { [weak self] item -> Observable<Alert?> in
                guard let self else { return .empty() }
                return self.xxxUseCase.processItem(item)
            }
            .observe(on: MainScheduler.instance)
            .subscribe(onNext: { [weak self] alert in
                guard let self else { return }
                if let alert {
                    output.presentAlert.accept(alert)
                } else {
                    self.actions.dismissViewController()
                }
            })
            .disposed(by: disposeBag)

        return output
    }
}



// MARK: - Private

extension Default<#ViewName#>ViewModel {

}
```

