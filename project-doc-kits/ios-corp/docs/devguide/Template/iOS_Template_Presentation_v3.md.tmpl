## ViewController 템플릿

**파일 위치**: `Presentation/Scene/[Scene]/[Feature]/View/`

```swift
import UIKit

import RxCocoa
import RxSwift

final class <#ViewName#>Controller: UIViewController {

    // MARK: - Property

    private let disposeBag = DisposeBag()
    private let rootView = <#ViewName#>()
    private let viewModel: <#ViewName#>Model



    // MARK: - Life Cycle

    init(_ viewModel: <#ViewName#>Model) {
        self.viewModel = viewModel
        super.init(nibName: nil, bundle: nil)
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    override func loadView() {
        self.view = self.rootView
    }

    override func viewDidLoad() {
        super.viewDidLoad()

        self.configure()
        self.bindViewModel()
    }



    // MARK: - Private

    private func configure() {
        // 네비게이션 바, 상태바, 제스처 등 설정
        self.navigationController?.setNavigationBarHidden(true, animated: false)
    }

    private func bindViewModel() {
        let input = Default<#ViewName#>Model.Input()

        // Input 바인딩
        self.rx.viewDidAppear
            .bind(to: input.viewDidAppear)
            .disposed(by: self.disposeBag)

        self.rootView.button.rx.tap
            .bind(to: input.buttonTap)
            .disposed(by: self.disposeBag)

        self.rootView.tableView.rx.modelSelected(Item.self)
            .bind(to: input.itemSelected)
            .disposed(by: self.disposeBag)

        // Output 바인딩
        let output = self.viewModel.transform(input: input, disposeBag: self.disposeBag)

        output.items
            .bind { [weak self] items in
                self?.rootView.updateItems(items)
            }
            .disposed(by: self.disposeBag)

        output.isLoading
            .unwrap()
            .bind { [weak self] isLoading in
                self?.rootView.setLoading(isLoading)
            }
            .disposed(by: self.disposeBag)
    }
}
```

