# iOS Presentation 템플릿 (3.0)

> [!abstract]
> Presentation 레이어의 코드 템플릿. View, ViewController, ViewModel의 구현 템플릿을 제공한다.

---

## View 템플릿

**파일 위치**: `Presentation/Scene/[Scene]/[Feature]/View/`

### 추가 섹션

| 섹션 | 용도 |
|------|------|
| **Nested Types** | State, Metric 등 내부 타입 정의 |
| **UI** | setAttribute(), setConstraint() |

```swift
import UIKit

import RxCocoa
import RxSwift
import SnapKit
import Then

final class <#ViewName#>: BaseView {

    // MARK: - Nested Types

    enum State {
        case selected
        case deselected
    }

    private struct Metric {
        static let padding: CGFloat = 16.0
    }



    // MARK: - Property

    private let titleLabel = UILabel().then { view in
        view.text = "제목"
        view.textColor = .white
        view.font = .systemFont(ofSize: 20.0, weight: .bold)
    }

    let actionButton = UIButton().then { view in
        view.setTitle("확인", for: .normal)
        view.tintColor = .systemBlue
    }

    private let contentsStackView = UIStackView().then { view in
        view.axis = .vertical
        view.spacing = 8.0
        view.alignment = .fill
    }



    // MARK: - Life Cycle

    override init() {
        super.init()

        self.setAttribute()
        self.setConstraint()
    }

    required init?(coder aDecoder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }



    // MARK: - Interface

    func updateState(_ state: State) {
        switch state {
        case .selected:
            self.backgroundColor = .systemBlue

        case .deselected:
            self.backgroundColor = .systemGray
        }
    }

    // RxSwift Binder
    var items: Binder<[String]> {
        return Binder(self) { view, items in
            items.forEach { item in
                let label = UILabel()
                label.text = item
                view.contentsStackView.addArrangedSubview(label)
            }
        }
    }



    // MARK: - Private

    private func handleAction() {
        // 내부 로직
    }



    // MARK: - UI

    private func setAttribute() {
        self.backgroundColor = .white

        [self.titleLabel, self.actionButton, self.contentsStackView]
            .forEach(self.addSubview(_:))
    }

    private func setConstraint() {
        let guide = self.safeAreaLayoutGuide

        self.titleLabel.snp.makeConstraints { make in
            make.top.equalTo(guide).offset(Metric.padding)
            make.leading.trailing.equalTo(guide).inset(Metric.padding)
        }

        self.actionButton.snp.makeConstraints { make in
            make.top.equalTo(self.titleLabel.snp.bottom).offset(Metric.padding)
            make.leading.trailing.equalTo(guide).inset(Metric.padding)
            make.height.equalTo(44.0)
        }

        self.contentsStackView.snp.makeConstraints { make in
            make.top.equalTo(self.actionButton.snp.bottom).offset(Metric.padding)
            make.leading.trailing.equalTo(guide).inset(Metric.padding)
            make.bottom.lessThanOrEqualTo(guide).inset(Metric.padding)
        }
    }
}
```

