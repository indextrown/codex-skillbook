│   ├── Mark/             # MarkList, MarkDetail, MarkEdit (Info + Style)
│   ├── MyVessel/         # Fenderline, Docking, Prediction, VesselSetting
│   ├── RoutePlan/        # RoutePlanList, RoutePlanDetail, RoutePlanEdit
│   ├── MyFleet/
│   ├── ENC/
│   ├── Menu/
│   ├── MOB/
│   ├── Delete/
│   ├── Search/
│   ├── Setting/
